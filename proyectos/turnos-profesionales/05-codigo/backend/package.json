{
  "name": "turnos-profesionales-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend modular monolito - Turnos Profesionales (TURNOS-2026-001)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "cross-env ENABLE_DEV_ROUTES=true ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/src/index.js",
    "build": "tsc -p tsconfig.json",
    "postbuild": "node -e \"require('fs').cpSync('migrations','dist/migrations',{recursive:true})\"",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:concurrencia": "node scripts/test-concurrent-booking.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "uuid": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^9.0.8",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3"
  }
}
